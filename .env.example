# Backend
BE_PORT=4000

# Frontend
FE_PORT=5173
FE_API_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:5173

# App
APP_TIMEZONE=Asia/Ho_Chi_Minh
DAILY_REMINDER_TIMES=14:55,17:30
STORAGE_FILE=./data/campaigns.json
ACCOUNT_EMAIL_DOMAIN=rikkeisoft.com

# Security for your own API
WEBHOOK_TOKEN=replace_with_your_internal_token

# Teams outgoing webhook (for reminder messages)
TEAMS_OUTGOING_WEBHOOK_URL=<your_teams_workflow_webhook_url>

# URL công khai của app (để Teams fetch ảnh QR). VD: https://your-domain.com hoặc https://xxx.ngrok.io
PUBLIC_BASE_URL=

# QR ngân hàng: chuỗi VietQR (tạo QR từ text, đính kèm tin nhắn). Hoặc dùng file qrcode.png
REMINDER_QR_CONTENT=
REMINDER_IMAGE_EMBED=true
REMINDER_IMAGE_FILE=qrcode.png
# Link ảnh PNG/SVG trực tiếp cho nhắc nợ (ưu tiên nếu có). VD: https://res.cloudinary.com/.../qrcode.png
REMINDER_IMAGE_URL=
# REMINDER_PLAIN_TEXT_ONLY=true: gửi text thuần (không ảnh) nếu Power Automate không hiển thị
REMINDER_PLAIN_TEXT_ONLY=

# Microsoft Cloud credentials (for future Graph/Bot integration)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_WEBHOOK_SECRET=
